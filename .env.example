# ==========================================
# SetupMint Environment Configuration (Cloud-Only)
# ==========================================

# Server Settings
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Database Settings (MongoDB Atlas — Required)
# SetupMint requires a MongoDB Atlas cluster URI. Local MongoDB is not supported.
# Remember to URL-encode any special characters (like @ as %40) in your password.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/tradevault?retryWrites=true&w=majority

# Cloudflare R2 / S3 Object Storage (Required)
# SetupMint stores private chart screenshots in Cloudflare R2.
# The bucket remains completely private; images are streamed only through authenticated endpoints.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=setupmint
S3_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
S3_PREFIX=journal-charts

# Multipart Upload Limits
MAX_FILE_SIZE_MB=10

# Session & Security
# Change these secrets in production. Both must be at least 32 characters.
SESSION_SECRET=supersecret-setupmint-session-encryption-key-change-me-32chars
TOKEN_ENCRYPTION_KEY=supersecret-setupmint-token-encryption-key-change-me-32chars
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# FYERS Broker Integration (optional)
# App ID and Secret Key are saved per-user in Settings and encrypted at rest.
FYERS_API_BASE=https://api-t1.fyers.in/api/v3
FYERS_REDIRECT_URI=http://127.0.0.1:4000/api/v1/integrations/fyers/callback
FYERS_FUNDS_DRIFT_TOLERANCE=1
FYERS_FUNDS_SYNC_ENABLED=true

# Default User Currency
DEFAULT_BASE_CURRENCY=INR

# ==========================================
# Off-Site Automated Backup Configuration (Disaster Recovery)
# ==========================================
# SetupMint dumps all Atlas collections + R2 screenshots nightly, encrypts with AES-256-GCM,
# and uploads to an isolated off-site bucket with 30 daily + 12 monthly retention.
# BACKUP_S3_BUCKET MUST be a different bucket from S3_BUCKET.
BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=setupmint-backups
BACKUP_S3_ACCESS_KEY_ID=<YOUR_BACKUP_R2_ACCESS_KEY_ID>
BACKUP_S3_SECRET_ACCESS_KEY=<YOUR_BACKUP_R2_SECRET_ACCESS_KEY>
BACKUP_S3_PREFIX=setupmint-backups

# Encryption Key for AES-256-GCM backups (REQUIRED, >= 32 characters).
# WARNING: If lost, encrypted backups cannot be decrypted or restored.
BACKUP_ENCRYPTION_KEY=supersecret-setupmint-backup-encryption-key-change-me-32chars

# Retention limits (default: 30 daily, 12 monthly, min 3 always kept)
BACKUP_RETAIN_DAILY=30
BACKUP_RETAIN_MONTHLY=12

# Anomaly detection drop percentage threshold (default: 10%)
# Runs with > 10% record drops in critical collections are marked SUSPICIOUS and segregated
BACKUP_MAX_DROP_PERCENT=10

# Optional Failure & Anomaly Alerts (Telegram Bot)
# Disabled when unset. Only alerts on FAILURE or SUSPICIOUS data loss (zero user data sent).
BACKUP_ALERT_TELEGRAM_BOT_TOKEN=
BACKUP_ALERT_TELEGRAM_CHAT_ID=
