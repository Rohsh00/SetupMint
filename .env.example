# ==========================================
# SetupMint Environment Configuration (Cloud-Only)
# ==========================================

# Server Settings
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Database Settings (MongoDB Atlas — Required)
# SetupMint requires a MongoDB Atlas cluster URI. Local MongoDB is not supported.
# Remember to URL-encode any special characters (like @ as %40) in your password.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/tradevault?retryWrites=true&w=majority

# Cloudflare R2 / S3 Object Storage (Required)
# SetupMint stores private chart screenshots in Cloudflare R2.
# The bucket remains completely private; images are streamed only through authenticated endpoints.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=setupmint
S3_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
S3_PREFIX=journal-charts

# Multipart Upload Limits
MAX_FILE_SIZE_MB=10

# Session & Security
# Change this secret key in production!
SESSION_SECRET=supersecret-setupmint-session-encryption-key-change-me-32chars
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173

# Default User Currency
DEFAULT_BASE_CURRENCY=INR
