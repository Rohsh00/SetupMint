data/
uploads/
*.db
dump/
backups/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pino-*.log

# OS generated files
.DS_Store
Thumbs.db

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

# Coverage & test output
coverage/
playwright-report/
test-results/
