{
  "name": "tradevault-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TradeVault - Professional Trading Journal Application",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"cyan.bold,magenta.bold\" \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/financial-engine && npm run build -w apps/api && npm run build -w apps/web",
    "build:api": "npm run build -w packages/shared && npm run build -w packages/financial-engine && npm run build -w apps/api",
    "start:api": "node apps/api/dist/server.js",
    "test": "npm run test -w packages/financial-engine && npm run test -w apps/api",
    "test:engine": "npm run test -w packages/financial-engine",
    "test:api": "npm run test -w apps/api",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w packages/financial-engine && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "lint": "eslint . --ext .ts,.tsx",
    "db:seed": "npm run seed -w apps/api --",
    "seed:demo": "npm run seed -w apps/api --",
    "seed:reset": "npm run seed:reset -w apps/api --",
    "seed:validate": "npm run seed:validate -w apps/api --",
    "instruments:backfill": "npm run instruments:backfill -w apps/api --",
    "accounts:backfill": "npm run accounts:backfill -w apps/api --",
    "excursion:backfill": "npm run excursion:backfill -w apps/api --",
    "chart:backfill": "npm run chart:backfill -w apps/api --",
    "sl:backfill": "npm run sl:backfill -w apps/api --",
    "db:clean": "npm run clean -w apps/api",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "db:reconcile": "node scripts/reconcile.js",
    "backup:scheduled": "node scripts/backup-scheduled.js",
    "backup:verify": "node scripts/backup-verify.js",
    "backup:restore-test": "node scripts/backup-restore-test.js",
    "backup:schedule:install": "node scripts/schedule/install-launchd.js",
    "backup:schedule:uninstall": "node scripts/schedule/uninstall-launchd.js",
    "docs:glossary": "tsx scripts/generate-glossary.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
